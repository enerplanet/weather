# ERA5_AREA=58.635,-8.182,49.959,1.769

# Retry attempts for a transient CDS failure rather than losing a month
# during a multi-week unattended run. Single source of truth for
# downloader.py's retry loop.
ERA5_CDS_MAX_RETRIES=10

# Delete the downloaded GRIB after each month's NetCDF is exported.
# Default false (keep everything). Every ERA5-Land runner's --cleanup
# flag defaults from this single setting; the flag still overrides it
# per-invocation.
ERA5_CLEANUP=false

# test_era5_multi_year.py's --from-year/--to-year defaults.
ERA5_FROM_YEAR=1940
ERA5_TO_YEAR=2025


# MERRA-2 path configuration

# NASA Earthdata credentials (used for MERRA-2 OPeNDAP access via GES
# DISC). Register a free account at https://urs.earthdata.nasa.gov/ and
# add "NASA GESDISC DATA ARCHIVE" under Applications > Authorized Apps
# (required even with correct username/password — without it GES DISC
# rejects data requests). Username/password is sufficient; no token
# needed. Alternatively, leave these unset and add a ~/.netrc entry for
# urs.earthdata.nasa.gov instead (see docs/MERRA2_PIPELINE_GUIDE.md).
EARTHDATA_USERNAME=<your_earthdata_username>
EARTHDATA_PASSWORD=<your_earthdata_password>

# Number of concurrent OPeNDAP requests. GES DISC has no CDS-style
# per-account job queue, so this can be higher than ERA5_CDS_MAX_CONCURRENT.
MERRA2_OPENDAP_MAX_CONCURRENT=8

# Retry attempts for a transient GES DISC failure (e.g. 503). Single
# source of truth for downloader.py's exponential_backoff call.
MERRA2_OPENDAP_MAX_RETRIES=10

# Bounding box order: North,West,South,East. Leave unset to derive from
# WEATHER_REGION above; set explicitly here for a custom box. An
# explicit value here always wins over WEATHER_REGION.
# MERRA2_AREA=72,-11,34,32

# Country presets -- uncomment one line to replace the box above (same
# [North,West,South,East] convention; see weather.geo.countries.COUNTRIES /
# `weather geo list`). Prefer `weather fetch --country <name>` for a
# per-invocation override instead of editing this file.
