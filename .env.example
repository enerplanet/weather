# Local weather path configuration
WEATHER_DATA_DIR=./data
COSMO_WORK_DIR=./data/cosmo_rea6
CONDA_BLD_PATH=./.conda-bld

# Scope ERA5-Land/MERRA-2 to a single country from `weather geo list`:
# derives both their WORK_DIR (<provider>/<region>/) and AREA
# automatically -- leave ERA5_AREA/MERRA2_AREA below unset to let this
# take effect. Does NOT apply to COSMO-REA6 (no AREA parameter exists
# for it) and does NOT support more than one country -- see
# docs/COUNTRY_SCOPED_ARCHIVES.md for a multi-country union.
# WEATHER_REGION=germany

# Delete intermediate .grb.bz2/.grb files after each month's NetCDF is
# exported. Default false (keep everything -- disk is cheap, re-downloads
# are not). Set true to reclaim disk automatically as each month finishes.
# Every COSMO runner's --cleanup/--no-cleanup CLI flag defaults from this
# single setting; the flag still overrides it per-invocation.
COSMO_CLEANUP=false

# test_cosmo_multi_year.py's --from-year/--to-year defaults (data actually
# available 1995-2019; --to-year default is one year short of that on
# purpose -- matches this script's pre-existing default, not "fixed" here).
COSMO_FROM_YEAR=1995
COSMO_TO_YEAR=2018

# Retry attempts for a transient DWD download failure (e.g. 503) before
# giving up on a file. Single source of truth for downloader.py's call
# into common/download.py's download_https_atomic.
COSMO_MAX_RETRIES=10


# ERA5-Land path configuration

# File format for ERA5 data (options: netcdf, grib).
# At the moment, grib is the best supported format for ERA5-Land data.
ERA5_DATA_FORMAT=grib

# Number of concurrent downloads from the Copernicus Climate Data Store (CDS).
# The default is 1, which is the maximum allowed by the CDS.
ERA5_CDS_MAX_CONCURRENT=1

# Linux server for fast parallel downloads of ERA5 data from the CDS server.
# The default is 1, which is the maximum allowed by the CDS.
ERA5_USE_ARIA2=1

ERA5_CDS_URL=https://cds.climate.copernicus.eu/api
ERA5_CDS_KEY=<your_key>

# CDS order: North,West,South,East. Leave unset to derive from
# WEATHER_REGION above; set explicitly here for a custom box (e.g. a
# multi-country union -- see docs/COUNTRY_SCOPED_ARCHIVES.md). An
# explicit value here always wins over WEATHER_REGION.
# ERA5_AREA=72,-11,34,32

# Retry attempts for a transient CDS failure rather than losing a month
# during a multi-week unattended run. Single source of truth for
# downloader.py's retry loop.
ERA5_CDS_MAX_RETRIES=10

# Delete the downloaded GRIB after each month's NetCDF is exported.
# Default false (keep everything). Every ERA5-Land runner's --cleanup
# flag defaults from this single setting; the flag still overrides it
# per-invocation.
ERA5_CLEANUP=false

# test_era5_multi_year.py's --from-year/--to-year defaults.
ERA5_FROM_YEAR=1940
ERA5_TO_YEAR=2025


# MERRA-2 path configuration

# NASA Earthdata credentials (used for MERRA-2 OPeNDAP access via GES
# DISC). Register a free account at https://urs.earthdata.nasa.gov/ and
# add "NASA GESDISC DATA ARCHIVE" under Applications > Authorized Apps
# (required even with correct username/password — without it GES DISC
# rejects data requests). Username/password is sufficient; no token
# needed. Alternatively, leave these unset and add a ~/.netrc entry for
# urs.earthdata.nasa.gov instead (see docs/MERRA2_PIPELINE_GUIDE.md).
EARTHDATA_USERNAME=<your_earthdata_username>
EARTHDATA_PASSWORD=<your_earthdata_password>

# Number of concurrent OPeNDAP requests. GES DISC has no CDS-style
# per-account job queue, so this can be higher than ERA5_CDS_MAX_CONCURRENT.
MERRA2_OPENDAP_MAX_CONCURRENT=8

# Retry attempts for a transient GES DISC failure (e.g. 503). Single
# source of truth for downloader.py's exponential_backoff call.
MERRA2_OPENDAP_MAX_RETRIES=10

# Bounding box order: North,West,South,East. Leave unset to derive from
# WEATHER_REGION above; set explicitly here for a custom box. An
# explicit value here always wins over WEATHER_REGION.
# MERRA2_AREA=72,-11,34,32

# Delete downloaded daily files after each month's NetCDF is exported.
# Default false (keep everything). Every MERRA-2 runner's --cleanup flag
# defaults from this single setting; the flag still overrides it
# per-invocation. Note the MERRA_ (not MERRA2_) prefix, matching
# MERRA_WORK_DIR/MERRA_NCORES.
MERRA_CLEANUP=false

# test_merra2_multi_year.py's --from-year/--to-year defaults. Same
# MERRA_ (not MERRA2_) prefix.
MERRA_FROM_YEAR=1980
MERRA_TO_YEAR=2025