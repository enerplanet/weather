# Local weather path configuration
WEATHER_DATA_DIR=./data
COSMO_WORK_DIR=./data/cosmo_rea6
CONDA_BLD_PATH=./.conda-bld

# Scope ERA5-Land/MERRA-2 to a single country from `weather geo list`:
# derives both their WORK_DIR (<provider>/<region>/) and AREA
# automatically -- leave ERA5_AREA/MERRA2_AREA below unset to let this
# take effect. Does NOT apply to COSMO-REA6 (no AREA parameter exists
# for it) and does NOT support more than one country -- see
# docs/COUNTRY_SCOPED_ARCHIVES.md for a multi-country union.
# WEATHER_REGION=germany

# Delete intermediate .grb.bz2/.grb files after each month's NetCDF is
# exported. Default false (keep everything -- disk is cheap, re-downloads
# are not). Set true to reclaim disk automatically as each month finishes.
# Every COSMO runner's --cleanup/--no-cleanup CLI flag defaults from this
# single setting; the flag still overrides it per-invocation.
COSMO_CLEANUP=false

# test_cosmo_multi_year.py's --from-year/--to-year defaults (data actually
# available 1995-2019; --to-year default is one year short of that on
# purpose -- matches this script's pre-existing default, not "fixed" here).
COSMO_FROM_YEAR=1995
COSMO_TO_YEAR=2018

# Retry attempts for a transient DWD download failure (e.g. 503) before
# giving up on a file. Single source of truth for downloader.py's call
# into common/download.py's download_https_atomic.
COSMO_MAX_RETRIES=10


# ERA5-Land path configuration

# File format for ERA5 data (options: netcdf, grib).
# At the moment, grib is the best supported format for ERA5-Land data.
ERA5_DATA_FORMAT=grib

# Number of concurrent downloads from the Copernicus Climate Data Store (CDS).
# The default is 1, which is the maximum allowed by the CDS.
ERA5_CDS_MAX_CONCURRENT=1

# Linux server for fast parallel downloads of ERA5 data from the CDS server.
# The default is 1, which is the maximum allowed by the CDS.
ERA5_USE_ARIA2=1

ERA5_CDS_URL=https://cds.climate.copernicus.eu/api
ERA5_CDS_KEY=<your_key>

# CDS order: North,West,South,East. Leave unset to derive from
# WEATHER_REGION above; set explicitly here for a custom box (e.g. a
# multi-country union -- see docs/COUNTRY_SCOPED_ARCHIVES.md). An
# explicit value here always wins over WEATHER_REGION.
# ERA5_AREA=72,-11,34,32

# Country presets -- uncomment one line to replace the box above (same
# [North,West,South,East] convention; see weather.geo.countries.COUNTRIES /
# `weather geo list`). Prefer `weather fetch --country <name>` for a
# per-invocation override instead of editing this file.
