# Delete downloaded daily files after each month's NetCDF is exported.
# Default false (keep everything). Every MERRA-2 runner's --cleanup flag
# defaults from this single setting; the flag still overrides it
# per-invocation. Note the MERRA_ (not MERRA2_) prefix, matching
# MERRA_WORK_DIR/MERRA_NCORES.
MERRA_CLEANUP=false

# test_merra2_multi_year.py's --from-year/--to-year defaults. Same
# MERRA_ (not MERRA2_) prefix.
MERRA_FROM_YEAR=1980
MERRA_TO_YEAR=2025

# ── weather serve (src/weather/api/) ────────────────────────────────────
# Comma-separated static API keys accepted via the X-API-Key header.
# Unset/empty = the server refuses every request (fails closed, not open).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Real value goes in .env only (gitignored) -- never commit an actual key.
# WEATHER_API_KEYS=

# Requests per key per 60s window. Default 60 if unset.
# WEATHER_API_RATE_LIMIT=60

# Launched via scripts/launch_weather_serve.sh -- see that script's header
# and src/weather/api/README.md for the full picture (why this exists,
# what it does and doesn't expose, and the deploy runbook).